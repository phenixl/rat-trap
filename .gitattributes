# Normalise line endings so that a checkout on any machine produces the same bytes.
#
# Without this, Git's core.autocrlf decides per machine, and files that the tool generates at
# runtime (reports, cursor files) can be compared against different bytes than they were written
# with - which matters here because the verification steps compare file bytes.
* text=auto eol=lf

# Windows-native sources and build files: keep CRLF so that editors and VS tooling agree.
*.cs        text eol=crlf
*.csproj    text eol=crlf
*.props     text eol=crlf
*.sln       text eol=crlf
*.manifest  text eol=crlf
*.ps1       text eol=crlf
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Never touch binary content.
*.ico   binary
*.png   binary
*.exe   binary
*.dll   binary
*.cur   binary
*.ani   binary
*.pdf   binary

# Keep diffs readable for the languages where it helps.
*.md    text eol=lf
*.py    text eol=lf
*.json  text eol=lf
*.xml   text eol=lf
*.cpp   text eol=lf
*.h     text eol=lf
