<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    rat-trap uses ZERO third-party packages.

    This file clears every package source on purpose. On the build machine TLS egress
    to nuget.org is blocked, so leaving the default sources configured produces long
    timeouts on every restore. With all sources cleared, restore resolves purely from
    the global packages folder (%USERPROFILE%\.nuget\packages), which is where the
    .NET SDK's own Native AOT compiler packs already live.

    If you ever add a package reference, re-add a source here first.
  -->
  <packageSources>
    <clear />
  </packageSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
