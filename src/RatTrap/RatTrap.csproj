<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RootNamespace>RatTrap</RootNamespace>
    <AssemblyName>rattrap</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <!-- Keep the output path identical whether the build is driven through the .sln (which
         supplies Platform=x64) or the project directly. Without this, one path gains an "x64"
         segment and the other does not, which makes scripts and documentation fragile. -->
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>

    <!-- Native AOT: ship a single self-contained native exe, no runtime install needed. -->
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <IsAotCompatible>true</IsAotCompatible>

    <!--
      We use ONLY source-generated interop:
        * [LibraryImport]          for Win32 flat API  (P/Invoke source generator)
        * [GeneratedComInterface]  for DXGI/D3D11 COM (COM interface source generator)
      Built-in COM interop and reflection-driven marshalling are unavailable under AOT,
      so keep this off and never introduce [ComImport] or [DllImport] with runtime
      marshalling of non-blittable types.
    -->
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyTitle>rat-trap</AssemblyTitle>
    <Product>rat-trap</Product>
    <Description>Recover cursor bitmaps (with colour and alpha) from screen capture: the compositor's own cursor where the OS draws one, and a solved reconstruction where an application draws its own. Exports PNG, .cur and .ani.</Description>
    <Version>0.2.0</Version>

    <!--
      InvariantGlobalization=true comes from Directory.Build.props; no ICU payload.
    -->
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <OptimizationPreference>Speed</OptimizationPreference>
    <StackTraceSupport>false</StackTraceSupport>
    <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
  </PropertyGroup>

  <!--
    Authenticode signing of the published executable.

    The certificate deliberately lives OUTSIDE the repository, in a folder shared by every project
    on this machine, so that one private key serves them all and cannot be committed by accident.
    See tools/sign.ps1 for how the key is located.

    Signing is opt-out rather than opt-in when the certificate is present, because forgetting to
    sign a release is silent, whereas a developer without the certificate gets one warning line.
    Override either way:
      dotnet publish ... -p:SignOutput=false             never sign
      dotnet publish ... -p:RatTrapSigningDir=D:\certs   use a different certificate folder
  -->
  <PropertyGroup>
    <RatTrapSigningDir Condition="'$(RatTrapSigningDir)' == ''">C:\ai-project\certs</RatTrapSigningDir>
    <SignOutput Condition="'$(SignOutput)' == '' AND Exists('$(RatTrapSigningDir)\phenixl-codesign.thumbprint.txt')">true</SignOutput>
  </PropertyGroup>

  <!--
    Hooked to CopyNativeBinary, and the reason is worth recording because getting it wrong is silent.

    Signing on AfterTargets="Publish" produced a build log reading "Successfully signed" next to a
    published binary with no signature on it. The cause is in the ILCompiler pack
    (Microsoft.NETCore.Native.Publish.targets): it defines

        <Target Name="CopyNativeBinary" AfterTargets="Publish">
          <Delete Files="$(PublishDir)\$(TargetName)$(NativeBinaryExt)" />
          <Copy SourceFiles="$(NativeOutputPath)$(TargetName)$(NativeBinaryExt)" ... />

    That target is also an AfterTarget of Publish, and because NuGet targets are imported after the
    project's own, it runs *after* any target the project hooks to Publish - deleting the signed binary
    and copying the unsigned native one back over it. MSBuild's Copy preserves the source's timestamp,
    so the file's timestamp did not even move, and the only symptom was a signature that was not there.

    CopyNativeBinary is therefore the last writer, so it is the correct place to hook. Signing is
    idempotent, and tools/publish.ps1 verifies the result rather than trusting the log.
  -->
  <Target Name="SignPublishedExecutable"
          AfterTargets="CopyNativeBinary"
          Condition="'$(SignOutput)' == 'true'">
    <PropertyGroup>
      <_RatTrapSignTarget>$([System.IO.Path]::GetFullPath('$(PublishDir)$(AssemblyName).exe'))</_RatTrapSignTarget>
    </PropertyGroup>
    <Message Importance="high" Text="Signing $(_RatTrapSignTarget)" Condition="Exists('$(_RatTrapSignTarget)')" />
    <!-- Best effort: an unsigned build is still a usable build, so a failure warns loudly rather than
         stopping the pipeline. Pass -Require to tools/sign.ps1 instead if a release must never ship
         unsigned, or use tools/publish.ps1, which verifies the signature afterwards. -->
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\tools\sign.ps1&quot; -Path &quot;$(_RatTrapSignTarget)&quot; -CertDir &quot;$(RatTrapSigningDir)&quot; -Description &quot;rat-trap cursor recovery&quot; -Quiet"
          Condition="Exists('$(_RatTrapSignTarget)')"
          ContinueOnError="WarnAndContinue" />
  </Target>

</Project>



